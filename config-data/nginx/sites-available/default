server {
    listen 80 default_server;

    # หน้าหลัก: แสดงหน้า Index.html
    location = / {
        root /var/www/html;
        index index.html;
    }

    # Proxy สำหรับ Contest 1 (ลิงก์ไปที่ CWS 9501)
    location /piriyalai/ {
        proxy_pass http://127.0.0.1:9501/; 
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Proxy สำหรับ Contest 2 (ลิงก์ไปที่ CWS 9502)
    location /newcontest/ {
        proxy_pass http://127.0.0.1:9502/;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
